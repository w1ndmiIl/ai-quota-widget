{
  "name": "ai-quota-widget",
  "version": "1.5.2",
  "description": "本地 AI Agent 额度与 Token 用量桌面悬浮窗",
  "author": "w1ndwill",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/run-electron.cjs",
    "test": "node --test",
    "check": "node scripts/check.js",
    "test:ui": "node scripts/run-electron.cjs scripts/smoke-renderer.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "build:win": "node scripts/build-win.js --win dir",
    "release:win": "node scripts/build-win.js --win nsis zip"
  },
  "keywords": [
    "ai-quota",
    "codex",
    "opencode",
    "gemini-cli",
    "cline",
    "electron",
    "desktop-widget"
  ],
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "io.github.w1ndwill.ai-quota-widget",
    "productName": "AI_bar",
    "artifactName": "AI_bar-v${version}-win-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.js",
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "executableName": "AI_bar",
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "scripts/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {}
}
